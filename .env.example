# Auth anti-abuse config
AUTH_SEND_CODE_WINDOW_MS=600000
AUTH_SEND_CODE_MAX=5
AUTH_LOGIN_WINDOW_MS=600000
AUTH_LOGIN_MAX=10
AUTH_LOGIN_FAIL_WINDOW_MS=900000
AUTH_LOGIN_FAIL_MAX=5

# Report review backend token
ADMIN_REVIEW_TOKEN=please-set-a-strong-token

# Retention scheduler
RETENTION_JOB_ENABLED=true
RETENTION_JOB_INTERVAL_MS=43200000
